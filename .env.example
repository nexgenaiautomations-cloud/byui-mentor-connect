DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Resend (https://resend.com) — 100 emails/day free, no credit card required.
# 1) Sign up · 2) Create an API key · 3) Paste it here.
# Verify the sending domain in Resend → Domains so the From below can actually send.
# icareeradvancementnetwork.com is verified in Resend (key: ican-production-2026-10).
AUTH_RESEND_KEY=
EMAIL_FROM="ICAN Mentor Connect <noreply@icareeradvancementnetwork.com>"

# Cron secret — Vercel adds `Authorization: Bearer $CRON_SECRET` to scheduled
# requests. Set it to a random string and Vercel will reuse it.
CRON_SECRET=

# Salt for the SHA-256 hash applied to IP addresses before audit rows are
# stored (src/lib/audit.ts). REQUIRED in production — without it the hash is
# unsalted and trivially reversible over the IPv4 space. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUDIT_IP_HASH_SECRET=

# Institution-configurable password policy (optional; defaults shown).
# Baseline of 8+ chars with a letter and a number always applies; these can
# only strengthen it. NEXT_PUBLIC_ so client forms and server enforce the
# same rules. Requires a redeploy to take effect.
NEXT_PUBLIC_PASSWORD_MIN_LENGTH=8
NEXT_PUBLIC_PASSWORD_REQUIRE_SYMBOL=false
NEXT_PUBLIC_PASSWORD_REQUIRE_MIXED_CASE=false

# Platform admins (comma-separated account emails) can add schools' email
# domains at /admin/schools. Separate from a school's program admins.
PLATFORM_ADMIN_EMAILS=
# Where "bring ICAN to your school" inquiries are emailed.
SCHOOL_INQUIRY_TO=GabrielD@nexgenaiintegrations.com
